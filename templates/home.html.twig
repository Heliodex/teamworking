{% extends "base.html.twig" %}

{% block title %}
    Home
{% endblock %}

{% block main %}
    <h1>Home</h1>

    <div class="products">
        {% for product in products %}
            <article class="product">
                <div class="info">
                    <h2>{{ product.name }}</h2>
                    <p>{{ product.description }}</p>

					<img src="{{ asset('product/' ~ product.id) }}" alt="{{ product.name }} image">

                    <data value="{{ product.price }}">Price: £{{ product.price / 100 }}</data>
                    <data value="{{ product.stock }}">Stock: {{ product.stock }}</data>
                </div>

                <form method="post">
                    <input type="hidden" name="productId" value="{{ product.id }}">

                    {% if product.inCart %}
                        <input type="hidden" name="action" value="remove">
                        <button type="submit">Remove from cart</button>
                    {% else %}
                        <input type="hidden" name="action" value="add">
                        <button type="submit">Add to cart</button>
                    {% endif %}
                </form>
            </article>
        {% endfor %}
    </div>
{% endblock %}