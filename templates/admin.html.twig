{% extends "base.html.twig" %}

{% block title %}
    Admin
{% endblock %}

{% block main %}
    <h1>Admin</h1>

    <h2>Add a new product</h2>

    {{ form(form) }}

    {% set flashes = app.flashes("success") %}
    {% if flashes %}
        <div style="padding-top: 1rem">
            <ul class="flash">
                {% for message in flashes %}
                    <li>{{ message }}</li>
                {% endfor %}
            </ul>
        </div>
    {% endif %}
{% endblock %}