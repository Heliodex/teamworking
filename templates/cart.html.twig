{% extends "base.html.twig" %}

{% block title %}
    Cart
{% endblock %}

{% block main %}
    <h1>Cart</h1>

    <div style="padding-bottom: 1rem">
        <a href="{{ path('orders') }}" >View completed orders</a>
    </div>

    <div class="products">
        {% for product in cart %}
            <article class="product">
                <div class="info">
                    <h2>{{ product.name }}</h2>
                    <p>{{ product.description }}</p>
                    <data value="{{ product.price }}">Price: £{{ product.price / 100 }}</data>
                </div>

                {# TODO: better user experience with a custom 'quantity' field and an 'Update" button? #}
                <form method="post" class="qty">
                    <button type="submit" name="set" value="{{ product.quantity - 1 }}">-</button>
                    <input type="hidden" name="productId" value="{{ product.id }}">
                    {{ product.quantity }}
                    <button type="submit" name="set" value="{{ product.quantity + 1 }}">+</button>
                </form>
            </article>
        {% endfor %}
    </div>

    <hr>

    {% if cart|length == 0 %}
        <p>Your cart is empty. Why not <a href="{{ path('home') }}">add some products</a>?</p>
    {% else %}
        <p>Subtotal: £{{ (total / 100)|number_format(2, ".", " ") }}</p>

        <a href="{{ path('checkout') }}" class="btn btn-primary">Checkout</a>
    {% endif %}
{% endblock %}