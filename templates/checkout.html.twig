{% extends "base.html.twig" %}

{% block title %}
    Checkout
{% endblock %}

{% block main %}
    <h1>Checkout</h1>

    {% for product in cart %}
        <article class="product">
            <div class="info">
                <h2>{{ product.name }}</h2>
                <p>{{ product.description }}</p>
                <data value="{{ product.price }}">Price: £{{ product.price / 100 }}</data>
            </div>

            <data value="{{ product.quantity }}">Quantity: {{ product.quantity }}</data>
        </article>

        <hr>

        <p>Total: £{{ (product.price * product.quantity) / 100 }}</p>

        <form method="post">
            <button type="submit">Complete purchase</button>
        </form>
    {% endfor %}

    {% if cart|length == 0 %}
        <p>Your cart is empty.</p>
    {% endif %}
{% endblock %}