{% extends "base.html.twig" %}

{% block title %}
    Checkout
{% endblock %}

{% block main %}
    <h1>Checkout</h1>

    <div class="products">
        {% for product in cart %}
            <article class="product">
                <div class="info">
                    <h2>{{ product.name }}</h2>
                    <p>{{ product.description }}</p>
                    <data value="{{ product.price }}">Price: £{{ product.price / 100 }}</data>
                </div>

                <data value="{{ product.quantity }}">Quantity: {{ product.quantity }}</data>
            </article>
        {% endfor %}
    </div>

    <hr>

    {% if cart|length == 0 %}
        <p>Your cart is empty.</p>
    {% else %}
        <p>Subtotal: £{{ (subtotal / 100)|number_format(2, ".", " ") }}</p>
        <p>Discounted: £{{ (discounttotal / 100)|number_format(2, ".", " ") }}</p>
        <p>Total (including VAT): £{{ (total / 100)|number_format(2, ".", " ") }}</p>

        <form method="post">
            <button type="submit">Complete purchase</button>
        </form>
    {% endif %}
{% endblock %}